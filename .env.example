# ---- RONB Clips settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start RONB Clips, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.
# The older RONBCLIPS_ setting names below still work. You can write RONBCLIPS_ instead of RONBCLIPS_ in any setting
# (for example RONBCLIPS_AI_KEY); when both are given, the newer name is the one that counts.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# RONB Clips uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; RONB Clips adds nothing on top.
# Without a key RONB Clips still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set RONBCLIPS_AI_BASE_URL
RONBCLIPS_AI_PROVIDER=gemini
RONBCLIPS_AI_MODELS=
RONBCLIPS_AI_KEY=
# RONBCLIPS_AI_KEY_FILE=/secrets/ai.txt        # instead of RONBCLIPS_AI_KEY: a file that holds the key
# RONBCLIPS_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# RONBCLIPS_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# ================================================================ on a server (Docker): see DEPLOY.md
# Your domain (DNS must already point at this server) and a database password you make up.
# RONBCLIPS_DOMAIN=ronbclips.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string
# RONBCLIPS_IMAGE=ghcr.io/ronbtech/ronb_clips:latest  # override the image used by docker compose

# A server RONB Clips has to itself: keep this line, and RONB Clips fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-ronbclips.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# RONBCLIPS_CADDYFILE=Caddyfile.origin
# RONBCLIPS_BIND_PORT=8765           # the port RONB Clips listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# Turn on proxy trust and restrict it to the proxy's addresses; never trust the header if visitors can reach
# this app directly. The app's Docker image sets RONBCLIPS_TRUST_PROXY=1 for Caddy on the same server.
# RONBCLIPS_TRUST_PROXY=1
# RONBCLIPS_CLIENT_IP_HEADER=CF-Connecting-IP
# RONBCLIPS_PROXY_IPS=127.0.0.1,::1

# On a server shared with other apps: keep RONB Clips inside its own share.
# RONBCLIPS_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# RONBCLIPS_CPUS=1.5                 # most processor cores it may use
# RONBCLIPS_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# RONBCLIPS_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, RONB Clips is stopped first
# RONBCLIPS_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# RONBCLIPS_DATA=./data              # videos, clips, the database file and the speech model
# RONBCLIPS_PORT=8765
# RONBCLIPS_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for connecting YouTube to post Shorts.
# Authorised redirect URI:  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# Instagram and TikTok: the apps people's accounts connect through (Connect buttons in Settings, Connected apps).
# These can also be pasted in the dashboard: Settings, Connected apps, Set up. Redirect addresses to
# register:  https://YOUR-DOMAIN/oauth/instagram/callback  and  https://YOUR-DOMAIN/oauth/tiktok/callback
# RONBCLIPS_IG_APP_ID=
# RONBCLIPS_IG_APP_SECRET=
# RONBCLIPS_IG_APP_ID_FILE=
# RONBCLIPS_IG_APP_SECRET_FILE=
# RONBCLIPS_TIKTOK_CLIENT_KEY=
# RONBCLIPS_TIKTOK_CLIENT_SECRET=
# RONBCLIPS_TIKTOK_CLIENT_KEY_FILE=
# RONBCLIPS_TIKTOK_CLIENT_SECRET_FILE=
# The *_FILE settings point at a file holding just that value; the direct setting wins when both are given.

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# RONBCLIPS_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# RONBCLIPS_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# RONBCLIPS_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# There are no limits unless you set one here: 0 (the default) means none. A server other people use may want some.
# RONBCLIPS_MAX_LIVE=8               # live recordings at once, whole server (default: twice the CPU cores; load decides below it)
# RONBCLIPS_MAX_LIVE_PER_USER=0      # streams one person records at once
# RONBCLIPS_MAX_JOBS_PER_USER=5      # videos one person sends and has worked on at once
# RONBCLIPS_MAX_UPLOAD_MB=0          # the largest video file someone may upload
# RONBCLIPS_UPLOAD_PART_MB=40        # big files are sent in pieces of this size (Cloudflare refuses requests over 100 MB)
# RONBCLIPS_MAX_VIDEO_HOURS=0        # longest video, or chosen part of one, that is processed
# RONBCLIPS_MAX_LIVE_HOURS=0         # a live recording stops by itself after this long
# RONBCLIPS_MAX_USER_GB=0            # disk space one account may use
# RONBCLIPS_MAX_CREATORS=0           # creators one account may add
# RONBCLIPS_FFMPEG_DIR=              # the folder that holds ffmpeg, if RONB Clips cannot find it by itself
# RONBCLIPS_ENCODER=                 # force the video encoder: nvenc, qsv, amf, videotoolbox or x264. Left unset, the
#                                    # graphics card is used when there is one (several times faster) and x264 otherwise
# RONBCLIPS_CLIP_MINUTES=15          # a clip that takes longer than this to make is stopped, so it cannot hold the video up
# RONBCLIPS_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com
# RONBCLIPS_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)
# RONBCLIPS_UPDATE_CHECK=1          # look on GitHub once a minute for a newer RONB Clips (0: never)
# RONBCLIPS_DRAIN_SECONDS=30         # on shutdown, how long queued work may take before it is left for recovery
# RONBCLIPS_LOG_LEVEL=info           # debug, info, warning or error; every line is JSON with a request id

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# RONBCLIPS_ASR_URL=http://10.0.0.2:9000
# RONBCLIPS_ASR_TOKEN=a-long-random-string-shared-by-both-machines

# ================================================================ settings found in the implementation
# Keep the names below in sync with settings read by studio/. The CI check reads their names directly from the code.
# Server and data folders
# RONBCLIPS_HOST=127.0.0.1
# RONBCLIPS_STORAGE_FILE=./storage.json
# RONBCLIPS_MODELS=                    # model folder (defaults to models inside the data folder)
# RONBCLIPS_FETCH_MODEL=1               # download the speech model at first start (0: skip)
# RONBCLIPS_AUTO_RELOAD=0               # development only: restart after Python source changes
# RONBCLIPS_REQUEST_THREADS=            # request thread limit (defaults from CPU count)
# RONBCLIPS_LIVE_AI_TIMEOUT=45          # maximum seconds to wait for one live-stream AI answer
# RONBCLIPS_REPO_URL=https://github.com/RONBTech/RONB_Clips
# RONBCLIPS_FOLLOW_URL=https://www.instagram.com/techbyronb/
# RONBCLIPS_FACEBOOK_URL=https://www.facebook.com/techbyronb/
# RONBCLIPS_UPDATE_REPO=RONBTech/RONB_Clips
# RONBCLIPS_UPDATE_BRANCH=main
#
# Additional video and machine limits
# RONBCLIPS_MAX_LIVE_PER_USER=0         # streams the local owner may record at once
# RONBCLIPS_MAX_LIVE_HOURS=0            # maximum hours per live recording (0: no limit)
# RONBCLIPS_MAX_VIDEO_HOURS=0           # maximum video duration (0: no limit)
# RONBCLIPS_MAX_USER_GB=0               # storage limit in GB (0: no limit)
# RONBCLIPS_MAX_CREATORS=0              # creator limit (0: no limit)
# RONBCLIPS_MAX_JOBS_PER_USER=5         # active videos (0: no limit)
# RONBCLIPS_MAX_UPLOAD_MB=0             # upload limit in MB (0: no limit)
# RONBCLIPS_MIN_FREE_DISK_GB=3          # pause new work below this free disk space
# RONBCLIPS_SKIP_STATIC=0                # skip long still sections in videos (0: off)
# RONBCLIPS_STATIC_THRESHOLD=0.4         # mean luma-change threshold for a still section
# RONBCLIPS_STATIC_MIN_SECONDS=6         # shortest still section to skip
# RONBCLIPS_FFMPEG_THREADS=              # override ffmpeg thread count
#
# Speech and remote ASR worker
# RONBCLIPS_ASR_MODEL=sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
# RONBCLIPS_ASR_PROVIDER=cpu              # cpu or cuda
# RONBCLIPS_ASR_THREADS=                  # local speech decoder threads (defaults from CPU count)
# RONBCLIPS_ASR_COPIES=                   # local decoder copies (defaults from CPU count)
# RONBCLIPS_ASR_REMOTE_BATCH=8             # pieces sent together to the remote worker
# RONBCLIPS_ASR_REMOTE_PARALLEL=4          # pieces of one video processed in parallel remotely
# RONBCLIPS_ASR_REMOTE_INFLIGHT=6          # remote requests allowed at once
# RONBCLIPS_ASR_HOST=127.0.0.1             # bind address when running studio.asr_worker
# RONBCLIPS_ASR_PORT=9000                  # port when running studio.asr_worker
# RONBCLIPS_ASR_BATCH=16                    # speech chunks decoded together by the worker
#
# Optional Instagram and TikTok secret files (direct values take precedence)
# RONBCLIPS_IG_APP_ID_FILE=/secrets/instagram-app-id.txt
# RONBCLIPS_IG_APP_SECRET_FILE=/secrets/instagram-app-secret.txt
# RONBCLIPS_TIKTOK_CLIENT_KEY_FILE=/secrets/tiktok-client-key.txt
# RONBCLIPS_TIKTOK_CLIENT_SECRET_FILE=/secrets/tiktok-client-secret.txt

# Also used by Docker Compose (not application settings):
# RONBCLIPS_DOMAIN=ronbclips.example.com
# RONBCLIPS_BIND_PORT=8765
# RONBCLIPS_CADDYFILE=Caddyfile
# RONBCLIPS_MEM_LIMIT=2g
# RONBCLIPS_CPUS=1.5
# RONBCLIPS_CPU_SHARES=256
# RONBCLIPS_OOM_SCORE_ADJ=900
# RONBCLIPS_DB_MEM_LIMIT=256m
